# Network binding for the local backend. Defaults: HOST=127.0.0.1, PORT=4174.
# Use a non-loopback HOST only behind appropriate access controls.
HOST=127.0.0.1
PORT=4174

# Vite development server port (default 5173) and its backend API target.
PAD_FRONTEND_PORT=5173
PAD_BACKEND_URL=http://127.0.0.1:4174

# Backend-only ElevenLabs credential. Keep this secret out of source control.
# Required only for live voice generation; local UI and tests work without it.
ELEVENLABS_API_KEY=

# Optional Codex generation guard in milliseconds (60000–10800000).
PAD_CODEX_GENERATION_TIMEOUT_MS=

# Optional ElevenLabs generation guard in milliseconds (1000–7200000).
# Ambiguous TTS requests are not retried automatically because they may cost money.
PAD_ELEVENLABS_GENERATION_TIMEOUT_MS=

# Optional Motion Canvas model and reasoning effort sent to Codex generation.
PAD_MOTION_CANVAS_MODEL=
PAD_MOTION_CANVAS_REASONING_EFFORT=

# Media tools. Leave blank to resolve from PATH. PAD_* aliases take precedence
# for final render; use FFMPEG_PATH/FFPROBE_PATH for the shared media runtime.
FFMPEG_PATH=
FFPROBE_PATH=
PAD_FFMPEG_PATH=
PAD_FFPROBE_PATH=

# Optional Chrome/Edge executable for final render; common install locations
# are detected when this is blank.
PAD_RENDER_BROWSER_PATH=

# Optional live-smoke overrides. They are used only by `npm run smoke:live`,
# which can call providers and may incur cost.
PAD_SMOKE_CODEX_MODEL=
PAD_SMOKE_CODEX_REASONING=
