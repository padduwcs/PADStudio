# Backend-only secret. Create a restricted key at:
# https://elevenlabs.io/app/settings/api-keys
#
# Required: Text to Speech Access, Models Access, Voices Read, User Read.
# Optional: History Read to suggest configurations used on elevenlabs.io.
ELEVENLABS_API_KEY=

# Optional. Without an override, timeout scales with reasoning effort: low 15m,
# medium 25m, high 40m, xhigh 60m, max 90m, ultra 120m. Motion scenes use at
# least 20m. Set milliseconds to intentionally replace that adaptive guard for
# every effort (minimum 60000, maximum 10800000).
PAD_CODEX_GENERATION_TIMEOUT_MS=

# Optional. TTS POST uses an adaptive 2–30 minute guard based on text length.
# Set milliseconds here only when the provider/network needs a deployment-wide
# override (minimum 1000, maximum 7200000). Costly POST requests are never
# retried automatically after an ambiguous disconnect or timeout.
PAD_ELEVENLABS_GENERATION_TIMEOUT_MS=

# Optional. Leave empty when ffmpeg is already available in PATH.
# Example on Windows: C:\tools\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Optional. Final render auto-detects Chrome/Edge in common locations.
# Set this only when the browser executable is installed elsewhere.
PAD_RENDER_BROWSER_PATH=

# Optional. Development frontend uses port 5173 by default.
# Set this together with PORT only when intentionally running another instance.
PAD_FRONTEND_PORT=
