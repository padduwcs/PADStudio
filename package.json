{
  "name": "pad-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "motion-canvas-runtime"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node --watch src/backend/server.ts",
    "motion:serve": "node scripts/motion-canvas.mjs serve",
    "sync:serve": "node scripts/motion-canvas.mjs serve --stage sync",
    "validate:motion": "node scripts/validate-motion-canvas.mjs",
    "validate:sync": "node scripts/validate-motion-canvas.mjs --stage sync",
    "check:media": "node scripts/check-media-policy.mjs",
    "smoke:live": "node scripts/live-integrations.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node src/backend/server.ts",
    "test:app": "node scripts/run-tests.mjs",
    "test:runtime": "npm test --workspace @pad-studio/motion-canvas-runtime",
    "test": "npm run test:app && npm run test:runtime",
    "test:pronunciation": "node --test src/shared/pronunciation.test.ts src/shared/videoFormat.test.ts src/backend/pronunciationRuleStore.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "validate": "npm run check:media && npm run test && npm run test:pronunciation && npm run build && npm run validate:motion && npm run validate:sync"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
